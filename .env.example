# BusinessHub SaaS - Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env or secrets to Git.

# Application Environment
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (MySQL + Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@127.0.0.1:3306/businesshub_dev"

# Authentication & Session Management
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-string"
NEXTAUTH_URL="http://localhost:3000"

# Super Admin Provisioning (Used strictly by scripts/bootstrap-superadmin.ts)
BOOTSTRAP_ADMIN_EMAIL="superadmin@businesshub.local"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-secure-super-admin-password"

# Email Delivery (For Expiring Single-Use Account Setup Links & Invitations)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="smtp-username-placeholder"
EMAIL_SERVER_PASSWORD="smtp-password-placeholder"
EMAIL_FROM="BusinessHub SaaS <noreply@businesshub.local>"

# Security & Invitation Expiry
INVITATION_TOKEN_TTL_HOURS=48

# Multi-Tenancy Constraints
DEFAULT_MAX_BUSINESS_OWNERS=10
